# ─────────────────────────────────────────
#  VSTUDY BROWSER CONFIGURATION
# ─────────────────────────────────────────
VSTUDY_URL=https://vstudy.saveetha.com/
VSTUDY_PROFILE_DIR=./vstudy_chrome_profile

# ─────────────────────────────────────────
#  TELEGRAM BOT SETTINGS
# ─────────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

DATABASE_NAME=./results.db
HEARTBEAT_FILE=./monitor.heartbeat
HEARTBEAT_TIMEOUT=900

# Cloud deployment data is mounted at /data by docker-compose.yml.
# Keep the production .env on the server and never commit it.
VSTUDY_DATA_DIR=./data
VSTUDY_IMAGE=vstudy-monitor:local

# Container deployment defaults
HEADLESS=false
UNATTENDED=false
RUN_FOREVER=false
CHECK_INTERVAL=300
SAVE_DEBUG_ARTIFACTS=false
